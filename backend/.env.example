## Server
PORT=3001
NODE_ENV=development

## CORS (frontend dev server)
# Example: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

## Email sending
# Set DRY_RUN=true to skip real sending and just return 202.
DRY_RUN=true

# Required when DRY_RUN=false
MAIL_FROM="Portfolio Contact <no-reply@your-domain.com>"
MAIL_TO=your-real-inbox@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ngominhtam26112005@gmail.com
SMTP_PASS=

